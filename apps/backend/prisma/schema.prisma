generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CourierRouteStatus {
  ACTIVE
  COMPLETED
  PENDING_NEXT_DAY
  CLOSED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum DeliveryStatus {
  LIBRE
  EMPACADO
  RECHAZADO
  PENDING_CALL
  CALL_COMPLETED
  CONFIRMED_FOR_DELIVERY
  ASSIGNED
  IN_ROUTE
  DELIVERED
  PARTIALLY_DELIVERED
  NOT_DELIVERED
  CANCELLED
  RETURNED
  PENDING
  SCHEDULED
  FAILED
  RESCHEDULED
}

enum DeactivationReason {
  PATIENT_DECEASED
  WRONG_ADDRESS
  WRONG_NUMBER
  TREATMENT_REJECTED
  MEDICATION_SUSPENDED
  EPS_CANCELLED
  DUPLICATE
  LOAD_ERROR
  NOT_LOCATED
  OTHER
}

enum PendingSubreason {
  NO_ANSWER
  PHONE_OFF
  RESCHEDULE_CALL
  PENDING_AUTHORIZATION
  PENDING_VALIDATION
  PENDING_ADDRESS
  OTHER
}

enum DeliveryPriority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  REASSIGNED
  CANCELLED
}

enum CallResult {
  ANSWERED
  NO_ANSWER
  OFF
  WRONG_NUMBER
  RESCHEDULE
  CONFIRMED
}

enum CallQueueStatus {
  PENDING
  CALLED
  ANSWERED
  NO_ANSWER
  OFF
  WRONG_NUMBER
  RESCHEDULE
  CONFIRMED
}

enum CallManagementResult {
  CONFIRMED_FOR_DELIVERY
  REQUIRES_UPDATE
  RESCHEDULE
  NOT_LOCATED
  WRONG_NUMBER
  SERVICE_REJECTED
}

enum MedicationStatus {
  ACTIVE
  INACTIVE
}

enum IncidentType {
  WRONG_ADDRESS
  PATIENT_ABSENT
  MEDICATION_REJECTED
  DANGEROUS_ZONE
  INCOMPLETE_ORDER
  PHONE_NO_ANSWER
  CLOSED_HOME
  OTHER
}

enum IncidentStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum EvidenceType {
  PHOTO
  SIGNATURE
  DOCUMENT
}

enum NotificationType {
  ASSIGNMENT
  URGENT_DELIVERY
  REASSIGNMENT
  PRIORITY_CHANGE
  SYSTEM
}

enum ExcelImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL
}

enum OfflineSyncStatus {
  PENDING
  SYNCING
  COMPLETED
  FAILED
  CONFLICT
}

enum OperationalType {
  DOMICILIARIO
  CONDUCTOR_RUTA
}

enum IntermunicipalRouteStatus {
  PREPARATION
  READY_FOR_DISPATCH
  DISPATCHED
  IN_ROUTE
  COMPLETED
  CANCELLED
}

enum IntermunicipalRouteHistoryAction {
  CREATED
  UPDATED
  STATUS_CHANGED
  DISPATCHED
  CLOSED
  CANCELLED
  DRIVER_CHANGED
  TRANSFERRED
  SPLIT
  DELIVERY_ADDED
  DELIVERY_REMOVED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
  SYNC
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String     @map("password_hash")
  firstName     String     @map("first_name")
  lastName      String     @map("last_name")
  phone         String?
  documentId    String?    @map("document_id")
  status        UserStatus @default(ACTIVE)
  operationalType OperationalType @default(DOMICILIARIO) @map("operational_type")
  roleId        String     @map("role_id")
  pushToken     String?    @map("push_token")
  lastLoginAt   DateTime?  @map("last_login_at")
  deletedAt     DateTime?  @map("deleted_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  role              Role               @relation(fields: [roleId], references: [id])
  refreshTokens     RefreshToken[]
  operatorProfile   Operator?
  courierProfile    Courier?
  assignments       Assignment[]       @relation("CourierAssignments")
  createdAssignments Assignment[]      @relation("CreatedAssignments")
  assignmentHistoryCourier AssignmentHistory[] @relation("CourierHistory")
  assignmentHistoryCreated AssignmentHistory[] @relation("CreatedHistory")
  incidents         Incident[]
  evidence          Evidence[]
  gpsLogs           GpsLog[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  excelImports      ExcelImport[]
  offlineSyncs      OfflineSync[]
  passwordResetTokens PasswordResetToken[]
  operatorCallAssignments CallAssignment[] @relation("OperatorCallAssignments")
  assignedCallAssignments CallAssignment[] @relation("AssignedCallAssignments")
  patientChanges    PatientChangeLog[]
  deliveryStatusLogs DeliveryStatusLog[]
  courierRoutes      CourierRoute[]
  intermunicipalRoutesDriven IntermunicipalRoute[] @relation("IntermunicipalRouteDriver")
  intermunicipalRoutesDispatched IntermunicipalRoute[] @relation("IntermunicipalRouteDispatchedBy")
  intermunicipalRouteHistory IntermunicipalRouteHistory[]

  @@index([email])
  @@index([roleId])
  @@index([status])
  @@index([operationalType])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  module      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Operator {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  code      String   @unique
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user        User          @relation(fields: [userId], references: [id])
  callHistory CallHistory[]

  @@map("operators")
}

model Courier {
  id           String   @id @default(cuid())
  userId       String   @unique @map("user_id")
  code         String   @unique
  vehicleType  String?  @map("vehicle_type")
  isAvailable  Boolean  @default(true) @map("is_available")
  currentLat   Float?   @map("current_lat")
  currentLng   Float?   @map("current_lng")
  lastGpsAt    DateTime? @map("last_gps_at")
  zone         String?
  lastConnectedAt DateTime? @map("last_connected_at")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([isAvailable])
  @@map("couriers")
}

model Patient {
  id           String   @id @default(cuid())
  documentId   String   @map("document_id")
  documentType String   @default("CC") @map("document_type")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  phone        String?
  phoneAlt     String?  @map("phone_alt")
  phoneFamily  String?  @map("phone_family")
  phoneAlternative String? @map("phone_alternative")
  address      String
  addressDetail String? @map("address_detail")
  city         String?
  neighborhood String?
  lat          Float?
  lng          Float?
  notes        String?
  uniqueHash   String   @unique @map("unique_hash")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  deliveries  Delivery[]
  callHistory CallHistory[]
  changeLogs  PatientChangeLog[]

  @@unique([documentId, documentType])
  @@index([documentId])
  @@index([phone])
  @@index([deletedAt])
  @@map("patients")
}

model Medication {
  id          String   @id @default(cuid())
  code        String   @unique
  cum         String?  @unique
  name        String
  laboratory  String?
  presentation String?
  concentration String?
  status      MedicationStatus @default(ACTIVE)
  description String?
  requiresColdChain Boolean @default(false) @map("requires_cold_chain")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  deliveryItems DeliveryItem[]

  @@index([name])
  @@index([cum])
  @@index([status])
  @@map("medications")
}

model Delivery {
  id              String           @id @default(cuid())
  deliveryNumber  String           @unique @map("delivery_number")
  documentNumber  String?          @map("document_number")
  patientId       String           @map("patient_id")
  status          DeliveryStatus   @default(PENDING_CALL)
  priority        DeliveryPriority @default(MEDIUM)
  pendingGeneratedAt DateTime?     @map("pending_generated_at")
  scheduledDate   DateTime?        @map("scheduled_date")
  scheduledTime   String?          @map("scheduled_time")
  deliveredAt     DateTime?        @map("delivered_at")
  failedAt        DateTime?        @map("failed_at")
  failureReason   String?          @map("failure_reason")
  observations    String?
  uniqueHash      String           @unique @map("unique_hash")
  excelImportId   String?          @map("excel_import_id")
  municipalityId  String?          @map("municipality_id")
  deletedAt       DateTime?        @map("deleted_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  patient       Patient        @relation(fields: [patientId], references: [id])
  excelImport   ExcelImport?   @relation(fields: [excelImportId], references: [id])
  municipality  RouteMunicipality? @relation(fields: [municipalityId], references: [id])
  items         DeliveryItem[]
  assignments   Assignment[]
  callHistory   CallHistory[]
  callAssignments CallAssignment[]
  statusLogs    DeliveryStatusLog[]
  incidents     Incident[]
  evidence      Evidence[]
  gpsLogs       GpsLog[]
  intermunicipalRouteDeliveries IntermunicipalRouteDelivery[]

  @@index([patientId])
  @@index([status])
  @@index([priority])
  @@index([scheduledDate])
  @@index([documentNumber])
  @@index([municipalityId])
  @@index([deletedAt])
  @@index([status, deletedAt])
  @@index([status, deletedAt, priority])
  @@map("deliveries")
}

model DeliveryItem {
  id           String   @id @default(cuid())
  deliveryId   String   @map("delivery_id")
  medicationId String   @map("medication_id")
  quantity     Int      @default(1)
  lotNumber    String?  @map("lot_number")
  expiryDate   DateTime? @map("expiry_date")
  unitPrice    Decimal? @map("unit_price") @db.Decimal(12, 2)
  observations String?
  uniqueHash   String   @unique @map("unique_hash")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  delivery   Delivery   @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  medication Medication @relation(fields: [medicationId], references: [id])

  @@index([deliveryId])
  @@index([medicationId])
  @@map("delivery_items")
}

model DeliveryStatusLog {
  id                  String              @id @default(cuid())
  deliveryId          String              @map("delivery_id")
  fromStatus          DeliveryStatus?     @map("from_status")
  toStatus            DeliveryStatus      @map("to_status")
  action              String
  deactivationReason  DeactivationReason? @map("deactivation_reason")
  pendingSubreason    PendingSubreason?   @map("pending_subreason")
  observations        String?
  changedById         String              @map("changed_by_id")
  createdAt           DateTime            @default(now()) @map("created_at")

  delivery  Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  changedBy User     @relation(fields: [changedById], references: [id])

  @@index([deliveryId])
  @@index([changedById])
  @@index([createdAt])
  @@map("delivery_status_logs")
}

model Assignment {
  id          String           @id @default(cuid())
  deliveryId  String           @map("delivery_id")
  courierId   String           @map("courier_id")
  routeId     String?          @map("route_id")
  intermunicipalRouteId String? @map("intermunicipal_route_id")
  assignedById String          @map("assigned_by_id")
  status      AssignmentStatus @default(PENDING)
  routeOrder  Int              @default(0) @map("route_order")
  assignedAt  DateTime         @default(now()) @map("assigned_at")
  acceptedAt  DateTime?        @map("accepted_at")
  completedAt DateTime?        @map("completed_at")
  notes       String?
  deletedAt   DateTime?        @map("deleted_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  delivery   Delivery @relation(fields: [deliveryId], references: [id])
  courier    User     @relation("CourierAssignments", fields: [courierId], references: [id])
  route      CourierRoute? @relation(fields: [routeId], references: [id])
  intermunicipalRoute IntermunicipalRoute? @relation(fields: [intermunicipalRouteId], references: [id])
  assignedBy User     @relation("CreatedAssignments", fields: [assignedById], references: [id])
  history    AssignmentHistory[]

  @@index([deliveryId])
  @@index([courierId])
  @@index([routeId])
  @@index([intermunicipalRouteId])
  @@index([status])
  @@map("assignments")
}

model CourierRoute {
  id             String             @id @default(cuid())
  courierId      String             @map("courier_id")
  routeDate      DateTime           @map("route_date") @db.Date
  status         CourierRouteStatus @default(ACTIVE)
  totalStops     Int                @default(0) @map("total_stops")
  completedStops Int                @default(0) @map("completed_stops")
  pendingStops   Int                @default(0) @map("pending_stops")
  notes          String?
  carriedFromId  String?            @map("carried_from_id")
  notifiedAt     DateTime?          @map("notified_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  courier     User         @relation(fields: [courierId], references: [id])
  assignments Assignment[]
  carriedFrom CourierRoute?  @relation("RouteCarryOver", fields: [carriedFromId], references: [id])
  carriedTo   CourierRoute[] @relation("RouteCarryOver")

  @@unique([courierId, routeDate])
  @@index([courierId])
  @@index([routeDate])
  @@index([status])
  @@map("courier_routes")
}

model AssignmentHistory {
  id           String           @id @default(cuid())
  assignmentId String           @map("assignment_id")
  courierId    String           @map("courier_id")
  action       String
  fromStatus   AssignmentStatus? @map("from_status")
  toStatus     AssignmentStatus? @map("to_status")
  notes        String?
  createdById  String           @map("created_by_id")
  createdAt    DateTime         @default(now()) @map("created_at")

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  courier    User       @relation("CourierHistory", fields: [courierId], references: [id])
  createdBy  User       @relation("CreatedHistory", fields: [createdById], references: [id])

  @@index([assignmentId])
  @@index([courierId])
  @@map("assignment_history")
}

model CallHistory {
  id           String     @id @default(cuid())
  deliveryId   String     @map("delivery_id")
  patientId    String     @map("patient_id")
  operatorId   String     @map("operator_id")
  phoneUsed    String     @map("phone_used")
  result       CallResult
  durationSec  Int?       @map("duration_sec")
  observations String?
  newPhone     String?    @map("new_phone")
  newAddress   String?    @map("new_address")
  rescheduleDate DateTime? @map("reschedule_date")
  rescheduleTime String?   @map("reschedule_time")
  calledAt     DateTime   @default(now()) @map("called_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  delivery Delivery @relation(fields: [deliveryId], references: [id])
  patient  Patient  @relation(fields: [patientId], references: [id])
  operator Operator @relation(fields: [operatorId], references: [id])

  @@index([deliveryId])
  @@index([patientId])
  @@index([operatorId])
  @@index([calledAt])
  @@map("call_history")
}

model CallAssignment {
  id               String              @id @default(cuid())
  deliveryId       String              @map("delivery_id")
  operatorUserId   String              @map("operator_user_id")
  assignedById     String              @map("assigned_by_id")
  status           CallQueueStatus     @default(PENDING)
  managementResult CallManagementResult? @map("management_result")
  observations     String?
  callDate         DateTime?           @map("call_date")
  callTime         String?             @map("call_time")
  durationSec      Int?                @map("duration_sec")
  phoneUsed        String?             @map("phone_used")
  assignedAt       DateTime            @default(now()) @map("assigned_at")
  completedAt      DateTime?           @map("completed_at")
  deletedAt        DateTime?           @map("deleted_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  delivery   Delivery @relation(fields: [deliveryId], references: [id])
  operator   User     @relation("OperatorCallAssignments", fields: [operatorUserId], references: [id])
  assignedBy User     @relation("AssignedCallAssignments", fields: [assignedById], references: [id])

  @@index([deliveryId])
  @@index([operatorUserId])
  @@index([status])
  @@index([assignedAt])
  @@index([operatorUserId, status, deletedAt])
  @@map("call_assignments")
}

model PatientChangeLog {
  id          String   @id @default(cuid())
  patientId   String   @map("patient_id")
  field       String
  oldValue    String?  @map("old_value")
  newValue    String?  @map("new_value")
  changedById String   @map("changed_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  patient   Patient @relation(fields: [patientId], references: [id])
  changedBy User    @relation(fields: [changedById], references: [id])

  @@index([patientId])
  @@index([changedById])
  @@index([createdAt])
  @@map("patient_change_logs")
}

model Incident {
  id           String         @id @default(cuid())
  deliveryId   String         @map("delivery_id")
  reportedById String         @map("reported_by_id")
  type         IncidentType
  status       IncidentStatus @default(OPEN)
  description  String
  lat          Float?
  lng          Float?
  accuracy     Float?
  resolvedAt   DateTime?      @map("resolved_at")
  resolution   String?
  deletedAt    DateTime?      @map("deleted_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  delivery   Delivery   @relation(fields: [deliveryId], references: [id])
  reportedBy User       @relation(fields: [reportedById], references: [id])
  evidence   Evidence[]

  @@index([deliveryId])
  @@index([type])
  @@index([status])
  @@map("incidents")
}

model Evidence {
  id           String       @id @default(cuid())
  deliveryId   String       @map("delivery_id")
  incidentId   String?      @map("incident_id")
  uploadedById String       @map("uploaded_by_id")
  type         EvidenceType
  filePath     String       @map("file_path")
  fileName     String       @map("file_name")
  mimeType     String       @map("mime_type")
  fileSize     Int          @map("file_size")
  lat          Float?
  lng          Float?
  deletedAt    DateTime?    @map("deleted_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  delivery   Delivery  @relation(fields: [deliveryId], references: [id])
  incident   Incident? @relation(fields: [incidentId], references: [id])
  uploadedBy User      @relation(fields: [uploadedById], references: [id])

  @@index([deliveryId])
  @@index([incidentId])
  @@map("evidence")
}

model GpsLog {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  deliveryId String?  @map("delivery_id")
  lat        Float
  lng        Float
  accuracy   Float?
  altitude   Float?
  speed      Float?
  heading    Float?
  deviceId   String?  @map("device_id")
  recordedAt DateTime @default(now()) @map("recorded_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id])
  delivery Delivery? @relation(fields: [deliveryId], references: [id])

  @@index([userId])
  @@index([deliveryId])
  @@index([recordedAt])
  @@map("gps_logs")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?     @map("user_id")
  action     AuditAction
  entity     String
  entityId   String?     @map("entity_id")
  oldData    Json?       @map("old_data")
  newData    Json?       @map("new_data")
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @map("user_agent")
  createdAt  DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ExcelImport {
  id            String            @id @default(cuid())
  fileName      String            @map("file_name")
  filePath      String            @map("file_path")
  status        ExcelImportStatus @default(PENDING)
  totalRows     Int               @default(0) @map("total_rows")
  processedRows Int               @default(0) @map("processed_rows")
  insertedCount Int               @default(0) @map("inserted_count")
  updatedCount  Int               @default(0) @map("updated_count")
  errorCount    Int               @default(0) @map("error_count")
  errors        Json?
  importedById  String            @map("imported_by_id")
  startedAt     DateTime?         @map("started_at")
  completedAt   DateTime?         @map("completed_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  importedBy User       @relation(fields: [importedById], references: [id])
  deliveries Delivery[]

  @@index([status])
  @@index([createdAt])
  @@map("excel_imports")
}

model OfflineSync {
  id           String            @id @default(cuid())
  userId       String            @map("user_id")
  deviceId     String            @map("device_id")
  payload      Json
  status       OfflineSyncStatus @default(PENDING)
  retryCount   Int               @default(0) @map("retry_count")
  lastError    String?           @map("last_error")
  syncedAt     DateTime?         @map("synced_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([deviceId])
  @@map("offline_sync")
}

model RouteMunicipality {
  id        String    @id @default(cuid())
  name      String    @unique
  code      String?   @unique
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  routes     IntermunicipalRoute[]
  deliveries Delivery[]

  @@index([isActive])
  @@map("route_municipalities")
}

model IntermunicipalRoute {
  id             String                    @id @default(cuid())
  routeCode      String                    @unique @map("route_code")
  routeDate      DateTime                  @map("route_date") @db.Date
  driverId       String                    @map("driver_id")
  municipalityId String                    @map("municipality_id")
  observations   String?
  status         IntermunicipalRouteStatus @default(PREPARATION)
  dispatchedAt   DateTime?                 @map("dispatched_at")
  dispatchedById String?                   @map("dispatched_by_id")
  closedAt       DateTime?                 @map("closed_at")
  parentRouteId  String?                   @map("parent_route_id")
  deletedAt      DateTime?                 @map("deleted_at")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")

  driver         User     @relation("IntermunicipalRouteDriver", fields: [driverId], references: [id])
  municipality   RouteMunicipality @relation(fields: [municipalityId], references: [id])
  dispatchedBy   User?    @relation("IntermunicipalRouteDispatchedBy", fields: [dispatchedById], references: [id])
  parentRoute    IntermunicipalRoute?  @relation("RouteSplit", fields: [parentRouteId], references: [id])
  childRoutes    IntermunicipalRoute[] @relation("RouteSplit")
  deliveries     IntermunicipalRouteDelivery[]
  assignments    Assignment[]
  history        IntermunicipalRouteHistory[]

  @@index([driverId])
  @@index([municipalityId])
  @@index([routeDate])
  @@index([status])
  @@map("intermunicipal_routes")
}

model IntermunicipalRouteDelivery {
  id         String    @id @default(cuid())
  routeId    String    @map("route_id")
  deliveryId String    @map("delivery_id")
  stopOrder  Int       @default(0) @map("stop_order")
  addedById  String?   @map("added_by_id")
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  route    IntermunicipalRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  delivery Delivery            @relation(fields: [deliveryId], references: [id])

  @@unique([routeId, deliveryId])
  @@index([routeId, stopOrder])
  @@index([deliveryId])
  @@map("intermunicipal_route_deliveries")
}

model IntermunicipalRouteHistory {
  id           String                           @id @default(cuid())
  routeId      String                           @map("route_id")
  action       IntermunicipalRouteHistoryAction
  fromStatus   IntermunicipalRouteStatus?       @map("from_status")
  toStatus     IntermunicipalRouteStatus?       @map("to_status")
  fromDriverId String?                          @map("from_driver_id")
  toDriverId   String?                          @map("to_driver_id")
  metadata     Json?
  notes        String?
  createdById  String                           @map("created_by_id")
  createdAt    DateTime                         @default(now()) @map("created_at")

  route     IntermunicipalRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  createdBy User                @relation(fields: [createdById], references: [id])

  @@index([routeId])
  @@index([createdAt])
  @@map("intermunicipal_route_history")
}
