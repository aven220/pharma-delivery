# MOBILE_API_URL — URL HTTPS pública del API (sin :8080 ni :8081).
# En build EAS se inyecta como EXPO_PUBLIC_API_URL.
#
# Celular físico o Expo Go → OBLIGATORIO (localhost NO funciona en el teléfono):
EXPO_PUBLIC_API_URL=http:/192.168.1.15
#
# Emulador Android / simulador iOS con backend local en la misma PC:
# EXPO_PUBLIC_API_URL=http://localhost:4000
#
# Backend en otra máquina de la red WiFi:
# EXPO_PUBLIC_API_URL=http://192.168.x.x:4000
#
# Tras cambiar este archivo: npx expo start -c
