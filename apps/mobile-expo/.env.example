# MOBILE_API_URL — URL HTTPS pública del API (sin :8080 ni :8081).
# En build EAS se inyecta como EXPO_PUBLIC_API_URL.
#
# Desarrollo local (Expo en simulador):
# EXPO_PUBLIC_API_URL=http://localhost:4000
#
# Producción (misma URL que WEB_API_URL en .env.production):
# EXPO_PUBLIC_API_URL=https://api.tu-dominio.com
#
EXPO_PUBLIC_API_URL=
