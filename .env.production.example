# A-AS Delivery — Variables de entorno PRODUCCIÓN
# Copiar y editar en el servidor:
#   cp .env.production.example .env.production
#   nano .env.production
#
# TLS (obligatorio antes de levantar el stack):
#   bash scripts/generate-prod-tls.sh
#   # o copiar certificados Let's Encrypt a infra/ssl/fullchain.pem y privkey.pem
#
# Secretos únicos:
#   openssl rand -base64 48
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=pharma
POSTGRES_PASSWORD=Pharma@2026_Segura_123220
POSTGRES_DB=pharma_delivery

# --- URLs públicas (HTTPS, sin puertos 8080/8081) ---
# Misma IP o dominio; el proxy edge enruta /api y /socket.io al backend.

WEB_PUBLIC_URL=https://20.5.19.8
WEB_API_URL=https://20.5.19.8
MOBILE_API_URL=https://20.5.19.8
CORS_ORIGIN=https://20.5.19.8

# --- JWT (mínimo 32 caracteres cada uno, valores distintos) ---
JWT_ACCESS_SECRET=CAMBIAR_con_openssl_rand_base64_48
JWT_REFRESH_SECRET=CAMBIAR_otro_secreto_distinto

# --- Logs ---
LOG_LEVEL=info

# --- Backups ---
BACKUP_RETENTION_DAYS=14

# --- Correo (recuperación de contraseña) ---
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=usuario@ejemplo.com
SMTP_PASS=CAMBIAR_clave_smtp
SMTP_FROM="A-AS Delivery <noreply@ejemplo.com>"

# --- Push móvil Expo (opcional) ---
EXPO_ACCESS_TOKEN=

# --- Proxy (detrás de edge NGINX) ---
TRUST_PROXY=true
