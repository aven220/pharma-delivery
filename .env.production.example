# =============================================================================
# A-AS Delivery — Variables de entorno PRODUCCIÓN
# Copiar a .env.production en la raíz del monorepo:
#   cp .env.production.example .env.production
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=pharma
POSTGRES_PASSWORD=cambiar_por_clave_segura_larga
POSTGRES_DB=pharma_delivery

# --- Puertos publicados ---
PUBLIC_PORT=8080
WEB_PORT=8081

# --- JWT (mínimo 32 caracteres, generar valores aleatorios únicos) ---
JWT_ACCESS_SECRET=cambiar_access_secret_minimo_32_caracteres
JWT_REFRESH_SECRET=cambiar_refresh_secret_minimo_32_caracteres

# --- CORS (URLs del admin web, separadas por coma) ---
CORS_ORIGIN=https://admin.tu-dominio.com

# --- URLs públicas ---
VITE_API_URL=https://api.tu-dominio.com
APP_PUBLIC_URL=https://admin.tu-dominio.com

# --- Logs ---
LOG_LEVEL=info

# --- Backups ---
BACKUP_RETENTION_DAYS=14

# --- Correo (recuperación de contraseña) ---
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_USER=no-reply@tu-dominio.com
SMTP_PASS=clave_smtp
SMTP_FROM="A-AS Delivery <no-reply@tu-dominio.com>"

# --- Push móvil Expo (opcional, desde expo.dev) ---
EXPO_ACCESS_TOKEN=
