# A-AS Delivery — Variables de entorno PRODUCCIÓN
# Copiar y editar en el servidor:
#   cp .env.production.example .env.production
#   nano .env.production
#
# TLS (obligatorio antes de levantar el stack):
#   bash scripts/generate-prod-tls.sh
#   # o copiar certificados Let's Encrypt a infra/ssl/fullchain.pem y privkey.pem
#
# Secretos únicos:
#   openssl rand -base64 48
# =============================================================================

# --- PostgreSQL (GRATIS — contenedor Docker, NO Azure Database for PostgreSQL) ---
# Los datos viven en el volumen postgres_data. Ver docs/FREE_STACK.md
POSTGRES_USER=pharma
POSTGRES_PASSWORD=Pharma@2026_Segura_123220
POSTGRES_DB=pharma_delivery

# --- URLs red local (equipo 192.168.20.26) — desarrollo sin HTTPS ---
# Para aplicar: npm run setup:lan
WEB_PUBLIC_URL=http://192.168.20.26:5173
WEB_API_URL=http://192.168.20.26:4000
MOBILE_API_URL=http://192.168.20.26:4000
CORS_ORIGIN=http://192.168.20.26:5173,http://localhost:5173

# --- URLs producción HTTPS (servidor público) — descomentar si despliega con Docker prod ---
# WEB_PUBLIC_URL=https://20.5.19.8
# WEB_API_URL=https://20.5.19.8
# MOBILE_API_URL=https://20.5.19.8
# CORS_ORIGIN=https://20.5.19.8

# --- JWT (mínimo 32 caracteres cada uno, valores distintos) ---
JWT_ACCESS_SECRET=9eKx3Pq7LmR2vY8NwT5ZaH1CdF6GhJ4220
JWT_REFRESH_SECRET=Y7bQ2LmN9KcR4TxP8VaD5FsH3ZwE1Gj220

# --- Logs ---
LOG_LEVEL=info

# --- Backups ---
BACKUP_RETENTION_DAYS=14

# --- Correo (recuperación de contraseña) ---
SMTP_HOST=smtp.cencoic.com.co
SMTP_PORT=587
SMTP_USER=aux.tecno.med@cencoic.com.co
SMTP_PASS=Pharma@2026_Segura_12322020
SMTP_FROM="A-AS Delivery <aux.tecno.med@cencoic.com.co>"

# --- Push móvil Expo (opcional) ---
EXPO_ACCESS_TOKEN=

# --- Proxy (detrás de edge NGINX) ---
TRUST_PROXY=true
